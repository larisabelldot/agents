run = "python3 -m http.server 3000"
entrypoint = "index.html"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "python3 -m http.server 3000"]
deploymentTarget = "static"
publicDir = "."

[[ports]]
localPort = 3000
externalPort = 80

[languages]

[languages.html]
pattern = "**/*.html"

[languages.javascript]
pattern = "**/*.js"
